{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "xmasapp",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-11-17",
  "assets": {
    // Unknown paths (e.g. /song/silent-night) serve index.html; the client routes.
    "not_found_handling": "single-page-application",
    // Only API requests and session links reach the Worker; everything else
    // is served as static assets.
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/s/*"]
  },
  "durable_objects": {
    "bindings": [{ "name": "SESSIONS", "class_name": "Session" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Session"] }],
  "routes": [{ "pattern": "xmascarols.app", "custom_domain": true }],
  // No request logging: the about page promises the site collects nothing.
  "observability": { "enabled": false }
}
